{
  "manifest_version": 3,
  "name": "EigenVault Password Manager",
  "version": "1.0.0",
  "description": "Secure password generator and manager with biometric unlock and smart auto-fill",
  "icons": {
    "128": "icons/icon.svg"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "128": "icons/icon.svg"
    },
    "default_title": "EigenVault"
  },
  "background": {
    "scripts": ["background/service-worker.js"],
    "type": "module"
  },
  "permissions": [
    "storage",
    "tabs",
    "contextMenus",
    "clipboardWrite",
    "unlimitedStorage",
    "webNavigation"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content/content-script.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["styles/*"],
      "matches": ["*://*/*"]
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "Command+Shift+L"
      }
    },
    "autofill": {
      "suggested_key": {
        "default": "Ctrl+Shift+F",
        "mac": "Command+Shift+F"
      },
      "description": "Auto-fill credentials on current page"
    },
    "generate": {
      "suggested_key": {
        "default": "Ctrl+Shift+G",
        "mac": "Command+Shift+G"
      },
      "description": "Generate new password"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "eigenvault@nihal.dev",
      "strict_min_version": "109.0"
    }
  }
}
